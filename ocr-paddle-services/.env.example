# Model text thông thường trên Ollama (ví dụ qwen2.5:7b hoặc model đang dùng)
OCR_OLLAMA_URL=http://host.docker.internal:11434
OCR_OLLAMA_MODEL=
OCR_OLLAMA_TIMEOUT_SECONDS=45
OCR_NUM_PREDICT=800

# Cấu hình PaddleOCR (chạy CPU mặc định, không tốn VRAM)
PADDLE_LANG=ch
PADDLE_USE_GPU=false
PADDLE_MIN_CONFIDENCE=0.5
