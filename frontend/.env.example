# Public browser URL, resolved at BUILD TIME. Rebuild after changing any NEXT_PUBLIC_* value.
# For another machine, use the API hostname/IP reachable from that browser.
# Never use Docker-only names such as chatbot-api here; never put secrets in this file.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Keep aligned with backend AUTH_MODE. Default: first-party production JWT login.
# Switch to development only for an explicitly selected local development backend.
NEXT_PUBLIC_AUTH_MODE=production
# Used only by development builds; this is not a production identity.
NEXT_PUBLIC_DEV_USER_ID=demo-user
