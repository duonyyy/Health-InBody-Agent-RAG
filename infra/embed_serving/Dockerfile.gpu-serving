# CUDA image pinned independently from the host driver. NVIDIA drivers are
# backward compatible with CUDA 12.8, avoiding the unbounded cu130 wheel that
# previously failed with "named symbol not found".
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

COPY requirements_serving.txt .

ARG TORCH_VERSION=2.8.0
RUN python3 -m pip install --no-cache-dir \
      "torch==${TORCH_VERSION}" \
      --index-url https://download.pytorch.org/whl/cu128 \
    && python3 -m pip install --no-cache-dir -r requirements_serving.txt

COPY scripts/serve_model.py .
COPY scripts/gunicorn_app.py .
COPY scripts/download_model_from_spaces.py .

RUN mkdir -p /app/models /app/logs

ENV MODEL_PATH=/app/models/bge-m3
ENV API_HOST=0.0.0.0
ENV API_PORT=5000
ENV DEBUG=false
ENV MAX_BATCH_SIZE=32
ENV EMBEDDING_DEVICE=cuda
ENV EMBEDDING_DTYPE=float16
ENV ENCODE_BATCH_SIZE=2

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# A second worker would load a second BGE-M3 copy and exceed a 4 GB RTX 3050.
CMD ["gunicorn", "--workers", "1", "--threads", "4", "--timeout", "180", "--bind", "0.0.0.0:5000", "gunicorn_app:app"]
