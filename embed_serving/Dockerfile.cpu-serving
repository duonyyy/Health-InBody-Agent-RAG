# Reproducible CPU fallback image.
FROM python:3.10-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements_serving.txt .

# Install an explicit CPU-only PyTorch wheel before common dependencies.
ARG TORCH_VERSION=2.13.0
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir \
      "torch==${TORCH_VERSION}" \
      --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements_serving.txt

# Copy application files
COPY scripts/serve_model.py .
COPY scripts/gunicorn_app.py .
COPY scripts/download_model_from_spaces.py .

# Create directories
RUN mkdir -p /app/models /app/logs

# Expose port
EXPOSE 5000

# Environment variables (có thể override)
ENV MODEL_PATH=/app/models/bge-m3
ENV API_HOST=0.0.0.0
ENV API_PORT=5000
ENV DEBUG=false
ENV MAX_BATCH_SIZE=32
ENV EMBEDDING_DEVICE=cpu
ENV EMBEDDING_DTYPE=float32
ENV ENCODE_BATCH_SIZE=8

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# One worker owns one model instance; threads are serialized around inference.
CMD ["gunicorn", "--workers", "1", "--threads", "4", "--timeout", "180", "--bind", "0.0.0.0:5000", "gunicorn_app:app"]
