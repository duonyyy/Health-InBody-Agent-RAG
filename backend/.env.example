# Backend runtime configuration example.
# See SETUP.md: generate secrets for a NEW installation without printing them.
# From repo root, use --env-file backend/.env for both infra and backend Compose.
# Existing PostgreSQL volumes keep their current password; do not regenerate it here.

DEBUG=False

# First-party production login issues short-lived signed JWTs.
# A trusted middleware may also inject request.state.current_user.
AUTH_MODE=production
# First-party JWT: generate a random secret of at least 32 bytes and keep it outside Git.
# Tokens require signature, issuer, audience, issued-at, not-before and expiry.
# No production identity can be accepted until all three are set.
JWT_SIGNING_KEY=
# These identifiers belong to this application's first-party JWT issuer, not an external IdP.
JWT_ISSUER=bodywise-local
JWT_AUDIENCE=bodywise-web
# Exact browser origins: scheme + host + port, no path or wildcard.
# Replace/add the real frontend origin for LAN/HTTPS deployment.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_LEGACY_USER_ENDPOINTS=false
ENABLE_PERSONALIZATION_DEBUG=false

# Optional Zep Cloud conversational memory. Keep false until trusted auth,
# per-user external-processing consent, privacy review, and rollout gates pass.
ZEP_MEMORY_ENABLED=false
ZEP_API_KEY=
# Generate a stable random secret of at least 32 characters; never rotate
# without an ID migration/deletion plan, or old Zep users become unreachable.
ZEP_ID_SECRET=
ZEP_HTTP_TIMEOUT_SECONDS=2
ZEP_ALLOW_DEV_IDENTITY=false
CHAT_RETENTION_DAYS=7
# HTTP corpus mutations require trusted server scope corpus:write and staging allowlist.
ENABLE_CORPUS_ADMIN_API=false
CORPUS_STAGING_COLLECTIONS=

# Retrieval/vector database
QDRANT_URL=http://qdrant-db:6333
QDRANT_COLLECTION_NAME=nmk_chatbot_active
# Stable alias used after a fully verified versioned import.
QDRANT_COLLECTION_ALIAS=nmk_chatbot_active
CORPUS_VERSION=
VECTOR_SIZE=1024

# Custom embedding service
# Default infra deployment: service DNS, not localhost inside containers.
CUSTOM_EMBEDDING_API_URL=http://embedding-api:5000
# For a standalone host service instead: http://host.docker.internal:5001
CUSTOM_EMBEDDING_ENABLED=true
USE_OPENAI_FALLBACK=false

# PostgreSQL
POSTGRES_DB=health_inbody
POSTGRES_USER=health_user
# Required private values. Keep DATABASE_URL consistent with POSTGRES_*.
# Use URL-encoding for special characters in credentials (SETUP generates hex secrets).
POSTGRES_PASSWORD=
DATABASE_URL=

# LLM provider: none, ollama, openai, custom
LLM_PROVIDER=none
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Required when LLM_PROVIDER=ollama, for example a model already installed in Ollama.
OLLAMA_MODEL=
# auto omits the Ollama-specific field; set false for thinking models when needed.
OLLAMA_THINK=auto
OLLAMA_NUM_CTX=2048
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60
LLM_ROUTER_MAX_TOKENS=16
LLM_ROUTER_TIMEOUT=8
LLM_NORMALIZE_MAX_TOKENS=96
LLM_NORMALIZE_TIMEOUT=10
LLM_REWRITE_MAX_TOKENS=128
LLM_REWRITE_TIMEOUT=15
LLM_COMPOSER_MAX_TOKENS=96
LLM_COMPOSER_TIMEOUT=35

# Exact-match response cache for generic BMI/PBF/SMM/BFM/InBody definitions only.
# Personal/profile/history/tool/web/medical-caution requests bypass this cache.
LLM_RESPONSE_CACHE_ENABLED=true
LLM_RESPONSE_CACHE_TTL_SECONDS=300
CACHE_MEMORY_MAX_ENTRIES=256
CACHE_REDIS_RETRY_SECONDS=5

# End-to-end Agent/RAG budget
AGENT_REQUEST_TIMEOUT_SECONDS=50

# InBody OCR remains disabled until upload/privacy and runtime gates pass.
FEATURE_OCR_UPLOAD=false
AGENT_COMPOSER_RESERVE_SECONDS=15
RAG_MAX_RETRIEVAL_QUERIES=1
AGENT_MAX_RETRIEVAL_CALLS=2
AGENT_MAX_COMPOSER_CALLS=2
RAG_EMBEDDING_TIMEOUT_SECONDS=15
QDRANT_TIMEOUT_SECONDS=30
QDRANT_SEARCH_TIMEOUT_SECONDS=5
RAG_COMPOSER_MAX_DOCS=3
RAG_COMPOSER_MAX_CHARS_PER_DOC=700

# Versioned BM25 snapshot (one API worker avoids duplicating the in-memory index)
API_WORKERS=1
BM25_AUTOLOAD=true
BM25_SNAPSHOT_PATH=/usr/src/app/data/generated/bm25_snapshot.json.gz

# Optional providers
OPENAI_API_KEY=
# Required only when LLM_PROVIDER=openai.
OPENAI_MODEL=
TAVILY_API_KEY=

# Langfuse Observability
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENV=development
LANGFUSE_MASK_HEALTH_PII=true
LANGFUSE_ID_SALT=health_inbody_salt_2026
