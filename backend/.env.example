# Backend runtime configuration example.
# Copy this file to `.env` for local development and adjust values as needed.

DEBUG=False

# Retrieval/vector database
QDRANT_URL=http://qdrant-db:6333
QDRANT_COLLECTION_NAME=nmk_chatbot_active
# Stable alias used after a fully verified versioned import.
QDRANT_COLLECTION_ALIAS=nmk_chatbot_active
CORPUS_VERSION=
VECTOR_SIZE=1024

# Custom embedding service
# If embed_serving runs separately on the host:
CUSTOM_EMBEDDING_API_URL=http://host.docker.internal:5001
# If embedding-api is placed in the same Docker network:
# CUSTOM_EMBEDDING_API_URL=http://embedding-api:5000
CUSTOM_EMBEDDING_ENABLED=true
USE_OPENAI_FALLBACK=false

# PostgreSQL
POSTGRES_DB=health_inbody
POSTGRES_USER=health_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://health_user:change-me@postgres-db:5432/health_inbody

# LLM provider: none, ollama, openai, custom
LLM_PROVIDER=none
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Required when LLM_PROVIDER=ollama, for example a model already installed in Ollama.
OLLAMA_MODEL=
# auto omits the Ollama-specific field; set false for thinking models when needed.
OLLAMA_THINK=auto
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60
LLM_ROUTER_MAX_TOKENS=16
LLM_ROUTER_TIMEOUT=8
LLM_NORMALIZE_MAX_TOKENS=96
LLM_NORMALIZE_TIMEOUT=10
LLM_REWRITE_MAX_TOKENS=128
LLM_REWRITE_TIMEOUT=15
LLM_COMPOSER_MAX_TOKENS=160
LLM_COMPOSER_TIMEOUT=20

# End-to-end Agent/RAG budget
AGENT_REQUEST_TIMEOUT_SECONDS=30
AGENT_COMPOSER_RESERVE_SECONDS=10
RAG_MAX_RETRIEVAL_QUERIES=1
RAG_EMBEDDING_TIMEOUT_SECONDS=10
QDRANT_TIMEOUT_SECONDS=30
QDRANT_SEARCH_TIMEOUT_SECONDS=5
RAG_COMPOSER_MAX_DOCS=3
RAG_COMPOSER_MAX_CHARS_PER_DOC=700

# Optional providers
OPENAI_API_KEY=
# Required only when LLM_PROVIDER=openai.
OPENAI_MODEL=
TAVILY_API_KEY=
